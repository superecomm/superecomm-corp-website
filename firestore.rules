rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Allow users to read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own profile on signup
      // Important: Allow creation if the auth UID matches the document ID
      allow create: if request.auth != null && 
                       request.auth.uid == userId &&
                       request.resource.data.uid == request.auth.uid;
      
      // Allow users to update their own data
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Don't allow delete
      allow delete: if false;
    }
    
    // Grid Accounts collection (not used yet, but keeping for later)
    match /grid_accounts/{gridAccountId} {
      // Allow users to read their own grid account
      allow read: if request.auth != null && 
                     resource.data.uid == request.auth.uid;
      
      // Allow creation of grid accounts (by the user)
      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid;
      
      // Don't allow updates or deletes for now
      allow update: if false;
      allow delete: if false;
    }
    
    // Counters collection (not used yet, but keeping for later)
    match /counters/{counterId} {
      // Only allow read/write by authenticated users (for reservation system)
      // In production, this should be restricted to backend/cloud functions only
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Career Applications collection
    match /career_applications/{applicationId} {
      // Allow anyone to create a career application (both logged in and anonymous users)
      allow create: if true;
      
      // Only allow users to read their own applications
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.email == request.auth.token.email);
      
      // Don't allow updates or deletes by users (only admins via console)
      allow update: if false;
      allow delete: if false;
    }
    
    // Support Requests collection
    match /support_requests/{requestId} {
      // Allow anyone to create a support request
      allow create: if true;
      
      // Only allow users to read their own requests
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.userEmail == request.auth.token.email);
      
      // Don't allow updates or deletes by users (only admins via console)
      allow update: if false;
      allow delete: if false;
    }
    
    // Layer 0 Email Signups collection
    match /layer0_signups/{signupId} {
      // Allow anyone to create a signup
      allow create: if true;
      
      // Don't allow read, update, or delete by users (only admins via console)
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}

